{
  "name": "desalink-demos",
  "private": true,
  "type": "module",
  "description": "Stageshow product demos for desalink.xyz, bundled into /js",
  "scripts": {
    "build": "esbuild src/main.tsx --bundle --minify --format=iife --target=es2020 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../js/demos.js --legal-comments=none",
    "watch": "npm run build -- --watch"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
